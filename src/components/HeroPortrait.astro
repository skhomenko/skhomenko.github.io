---
import { portrait } from "../data/profile";

// Rendered only when a portrait is configured; the caller guards on this too.
const photo = portrait!;
const srcset = photo.sources.map((s) => `${s.src} ${s.width}w`).join(", ");
const fallback = photo.sources[photo.sources.length - 1];
---

<figure class="portrait">
  <img
    src={fallback.src}
    srcset={srcset}
    sizes="(max-width: 900px) min(88vw, 26rem), min(34vw, 30rem)"
    alt={photo.alt}
    width="1000"
    height="1000"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</figure>
