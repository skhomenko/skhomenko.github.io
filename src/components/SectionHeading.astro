---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "split";
}

const { eyebrow, title, description, align = "split" } = Astro.props;
---

<header class:list={["section-heading", `section-heading--${align}`]}>
  <div class="section-heading__label">
    <p class="eyebrow">{eyebrow}</p>
  </div>
  <div>
    <h2>{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
  </div>
</header>
