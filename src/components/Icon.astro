---
type IconName =
  "arrow" | "download" | "github" | "linkedin" | "mail" | "external" | "check";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14" />
        <path d="m14 7 5 5-5 5" />
      </>
    )
  }
  {
    name === "download" && (
      <>
        <path d="M12 3v12" />
        <path d="m7 10 5 5 5-5" />
        <path d="M5 21h14" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {
    name === "external" && (
      <>
        <path d="M15 4h5v5" />
        <path d="m20 4-9 9" />
        <path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
      </>
    )
  }
  {
    name === "check" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="m8 12 2.7 2.7L16 9" />
      </>
    )
  }
  {
    name === "github" && (
      <path d="M15 22v-3.9c.04-1-.35-1.97-1.1-2.6 3.6-.4 7.4-1.77 7.4-8A6.25 6.25 0 0 0 19.64 3c.17-.9.08-1.84-.26-2.7 0 0-1.3-.42-4.38 1.65a15.2 15.2 0 0 0-8 0C3.92-.12 2.62.3 2.62.3a6.13 6.13 0 0 0-.26 2.7A6.25 6.25 0 0 0 .7 7.5c0 6.22 3.8 7.6 7.4 8-.74.62-1.13 1.57-1.1 2.56V22M7 19c-3 .9-3-1.5-4.2-2" />
    )
  }
  {
    name === "linkedin" && (
      <>
        <rect x="3" y="9" width="4" height="12" />
        <circle cx="5" cy="5" r="2" />
        <path d="M11 21v-7c0-2.76 2.24-5 5-5s5 2.24 5 5v7" />
        <path d="M11 9v12" />
      </>
    )
  }
</svg>
