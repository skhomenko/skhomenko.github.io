---
import AiWorkflow from "../components/AiWorkflow.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { capabilities } from "../data/capabilities";
import { principles } from "../data/principles";
import { projects } from "../data/projects";
import { skillGroups } from "../data/skills";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Hero />

  <section id="expertise" class="section shell">
    <SectionHeading
      eyebrow="What I build"
      title="Quality systems built for how engineering actually works."
      description="Automation, delivery infrastructure, and quality signals are really one system, so I work on them together. What a team needs is a clear answer sooner, and that rarely comes from running more tests."
    />
    <div class="capability-list">
      {
        capabilities.map((capability) => (
          <article class="capability">
            <h3>{capability.title}</h3>
            <div class="capability__copy">
              <p>{capability.summary}</p>
              <p>{capability.value}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section id="work" class="section work-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected engineering work"
        title="What I’ve built, and why it was built that way."
        description="Each one covers the problem, the decisions I made, and what the system gave back to the people using it. Anything confidential has been left out or generalized."
      />
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-action">
        <a class="text-link" href="/work"
          >View all case studies <Icon name="arrow" /></a
        >
      </div>
    </div>
  </section>

  <section id="applied-ai" class="section shell">
    <div class="ai-intro">
      <SectionHeading
        eyebrow="Applied AI"
        title="Use AI where interpretation helps. Keep facts deterministic."
        description="I treat LLMs as engineering tools and judge them the same way. They earn their place on classification, summarizing, and design review, provided the inputs and the review path are pinned down first."
        align="left"
      />
      <p class="ai-intro__note">
        AI doesn’t replace test logic, and it doesn’t take responsibility for a
        release. Model size, context limits, privacy, latency, and cost are
        design constraints like any others.
      </p>
    </div>
    <AiWorkflow />
    <div class="section-action">
      <a class="text-link" href="/work/bilingual-document-assistant"
        >See this running in a real system <Icon name="arrow" /></a
      >
    </div>
  </section>

  <section id="approach" class="section shell">
    <SectionHeading
      eyebrow="Engineering principles"
      title="Confidence comes from the quality of the signal."
      description="The ideas I keep coming back to when I’m designing a system or reviewing someone else’s."
    />
    <div class="principles-layout">
      {
        principles.map((principle) => (
          <article
            class:list={[
              "principle",
              principle.emphasis && "principle--accent",
            ]}
          >
            <h3>{principle.title}</h3>
            <p>{principle.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="toolbox" class="section shell">
    <SectionHeading
      eyebrow="Technical toolbox"
      title="Technology, grouped by the job it does."
      description="Tools only matter in context. This is grouped by the work they do, which is more useful than an alphabetical wall of logos."
    />
    <div class="toolbox-grid">
      {
        skillGroups.map((group) => (
          <article class="toolbox-group">
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul aria-label={`${group.title} technologies and practices`}>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <Contact />
</BaseLayout>
